    "html": "<!doctype html>\n<html lang=\"de\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Drehbares Glasgeländer</title>\n<style>*{box-sizing:border-box}html,body{margin:0;width:100%;height:100%;background:transparent}body{font:13px Arial,sans-serif}.viewer{position:relative;width:100%;height:100svh;min-height:240px;overflow:hidden;border-radius:20px;background:radial-gradient(ellipse at 55% 45%,#e9e4d9,#efede6 70%)}#scene{position:absolute;inset:0;cursor:grab;touch-action:none}#scene:active{cursor:grabbing}#scene canvas,#scene svg{display:block;width:100%;height:100%}.controls{position:absolute;right:18px;bottom:18px;display:flex;gap:6px;z-index:2}.controls button{width:33px;height:33px;border-radius:50%;border:1px solid #d1cec3;background:#f9f7f1;color:#817d71;font:17px Georgia,serif;cursor:pointer}button:focus-visible,#scene:focus-visible{outline:2px solid #b87540;outline-offset:-3px}.sr-only{position:absolute;width:1px;height:1px;margin:-1px;padding:0;overflow:hidden;clip:rect(0,0,0,0);border:0}noscript{position:absolute;inset:45% 10%;color:#777568;text-align:center}</style></head><body>\n<main class=\"viewer\" aria-label=\"Interaktives 3D-Modell eines Glasgeländers\"><div id=\"scene\" tabindex=\"0\" role=\"img\" aria-label=\"Glasgeländer mit drei Glaselementen. Ziehen oder Pfeiltasten zum Drehen; Mausrad oder Plus und Minus zum Zoomen; Pos1 zum Zurücksetzen.\" aria-describedby=\"renderHint\"></div><span class=\"sr-only\" id=\"renderHint\">Ziehen zum Drehen · Scrollen zum Zoomen</span><div class=\"controls\"><button type=\"button\" id=\"motion\" aria-pressed=\"false\" aria-label=\"Animation pausieren\">Ⅱ</button><button type=\"button\" id=\"reset\" aria-label=\"Ansicht zurücksetzen\" title=\"Ansicht zurücksetzen\">↺</button></div><noscript>Bitte JavaScript aktivieren, um das 3D-Modell zu drehen.</noscript></main>\n<script type=\"module\">\nimport * as THREE from \"https://cdn.jsdelivr.net/npm/three@0.170.0/build/three.module.js\";\n(()=>{\nconst $=s=>document.querySelector(s), reduced=matchMedia('(prefers-reduced-motion: reduce)').matches;\nlet paused=reduced,zoom=1,rot=-.5,tilt=.35,dragging=false,lastX=0,lastY=0;\nconst scene=new THREE.Scene(),camera=new THREE.PerspectiveCamera(33,1,.1,100);camera.position.set(8,6,10);camera.lookAt(0,1,0);let root=new THREE.Group();scene.add(root);scene.add(new THREE.HemisphereLight(0xffffff,0x819477,3));const sun=new THREE.DirectionalLight(0xffffff,4);sun.position.set(3,8,6);scene.add(sun);const container=$('#scene');let renderer,svg,fallback=false;\ntry{const probe=document.createElement('canvas');if(!probe.getContext('webgl2'))throw Error('WebGL unavailable');renderer=new THREE.WebGLRenderer({alpha:true,antialias:true});renderer.setPixelRatio(Math.min(devicePixelRatio,2));renderer.setClearColor(0,0);renderer.outputColorSpace=THREE.SRGBColorSpace;container.append(renderer.domElement)}catch(e){fallback=true;svg=document.createElementNS('http://www.w3.org/2000/svg','svg');svg.setAttribute('aria-hidden','true');container.append(svg);$('#renderHint').textContent='Ziehen zum Drehen · 3D-Kompatibilitätsansicht'}\nconst colors={green:0x41413f,lime:0xf26a3d,dark:0x252524,white:0xf7f4ed,glass:0xc5c9c6,gray:0x96948c};\nfunction mesh(geo,col,x=0,y=0,z=0){const m=new THREE.Mesh(geo,new THREE.MeshStandardMaterial({color:col,roughness:.48,metalness:.15}));m.position.set(x,y,z);root.add(m);return m}function box(w,h,d,c,x,y,z){return mesh(new THREE.BoxGeometry(w,h,d),c,x,y,z)}function ball(r,c,x,y,z){return mesh(new THREE.IcosahedronGeometry(r,1),c,x,y,z)}function bar(a,b,r,c){let A=new THREE.Vector3(...a),B=new THREE.Vector3(...b),m=mesh(new THREE.CylinderGeometry(r,r,A.distanceTo(B),8),c);m.position.copy(A.add(B).multiplyScalar(.5));m.quaternion.setFromUnitVectors(new THREE.Vector3(0,1,0),B.sub(new THREE.Vector3(...a)).normalize());return m}\nfunction base(){mesh(new THREE.CylinderGeometry(2.7,2.7,.12,48),0xe7e2d9,0,-.12,0);box(3.9,.16,2.6,colors.white,0,0,0)}\nfunction makeModel(){while(root.children.length){const o=root.children.pop();o.geometry?.dispose();o.material?.dispose()}base();box(4,.28,.45,colors.gray,0,.3,0);for(let i=0;i<3;i++){box(1.22,2.1,.09,colors.glass,-1.3+i*1.3,1.5,0);box(.025,2.1,.11,colors.white,-1.9+i*1.3,1.5,0);mesh(new THREE.CylinderGeometry(.12,.12,.12,12),colors.lime,-1.3+i*1.3,.6,.14)}box(4.05,.08,.19,colors.dark,0,2.58,0);box(.14,.28,.5,colors.dark,2,.3,0);root.rotation.y=rot;}\nfunction resize(){const w=container.clientWidth,h=container.clientHeight;if(!w||!h)return;camera.aspect=w/h;camera.updateProjectionMatrix();renderer?.setSize(w,h);if(svg)svg.setAttribute('viewBox',`0 0 ${w} ${h}`)}new ResizeObserver(resize).observe(container);\nconst vA=new THREE.Vector3(),vB=new THREE.Vector3(),vC=new THREE.Vector3(),normal=new THREE.Vector3(),light=new THREE.Vector3(3,8,6).normalize();function software(){const w=container.clientWidth,h=container.clientHeight,polys=[];scene.updateMatrixWorld();root.children.forEach(m=>{const p=m.geometry.attributes.position,ix=m.geometry.index,c=m.material.color;for(let k=0;k<(ix?ix.count:p.count);k+=3){vA.fromBufferAttribute(p,ix?ix.getX(k):k).applyMatrix4(m.matrixWorld);vB.fromBufferAttribute(p,ix?ix.getX(k+1):k+1).applyMatrix4(m.matrixWorld);vC.fromBufferAttribute(p,ix?ix.getX(k+2):k+2).applyMatrix4(m.matrixWorld);normal.crossVectors(new THREE.Vector3().subVectors(vB,vA),new THREE.Vector3().subVectors(vC,vA)).normalize();if(normal.dot(new THREE.Vector3().subVectors(camera.position,vA))<0)continue;const shade=.67+Math.max(0,normal.dot(light))*.3;vA.project(camera);vB.project(camera);vC.project(camera);const rgb=[c.r,c.g,c.b].map(x=>Math.round(THREE.MathUtils.clamp(new THREE.Color(x,x,x).convertLinearToSRGB().r*shade,0,1)*255));polys.push({z:(vA.z+vB.z+vC.z)/3,s:`<path d=\"M${((vA.x+1)*w/2).toFixed(1)},${((-vA.y+1)*h/2).toFixed(1)}L${((vB.x+1)*w/2).toFixed(1)},${((-vB.y+1)*h/2).toFixed(1)}L${((vC.x+1)*w/2).toFixed(1)},${((-vC.y+1)*h/2).toFixed(1)}Z\" fill=\"rgb(${rgb})\" stroke=\"rgb(${rgb})\" stroke-width=\".4\"/>`})}});polys.sort((a,b)=>b.z-a.z);svg.innerHTML=polys.map(p=>p.s).join('')}\nlet lastTime=0;function animate(t){requestAnimationFrame(animate);if(document.hidden||!container.getBoundingClientRect().height||t-lastTime<(fallback?80:30))return;const dt=Math.min((t-lastTime)/1000,.1);lastTime=t;if(!paused&&!dragging)rot+=dt*.07;root.rotation.y=rot;root.rotation.x=tilt-.35;camera.position.set(8*zoom,6*zoom,10*zoom);camera.lookAt(0,1,0);camera.updateMatrixWorld();if(fallback)software();else renderer.render(scene,camera)}\ncontainer.addEventListener('pointerdown',e=>{dragging=true;lastX=e.clientX;lastY=e.clientY;container.setPointerCapture(e.pointerId)});container.addEventListener('pointermove',e=>{if(!dragging)return;rot+=(e.clientX-lastX)*.008;tilt=THREE.MathUtils.clamp(tilt+(e.clientY-lastY)*.004,-.2,1);lastX=e.clientX;lastY=e.clientY});container.addEventListener('pointerup',()=>dragging=false);container.addEventListener('pointercancel',()=>dragging=false);container.addEventListener('wheel',e=>{e.preventDefault();zoom=THREE.MathUtils.clamp(zoom+e.deltaY*.0008,.7,1.45)},{passive:false});$('#reset').onclick=()=>{rot=-.5;tilt=.35;zoom=1};container.addEventListener('keydown',e=>{if(['ArrowLeft','ArrowRight','ArrowUp','ArrowDown','+','-','Home'].includes(e.key)){e.preventDefault();if(e.key==='ArrowLeft')rot-=.12;if(e.key==='ArrowRight')rot+=.12;if(e.key==='ArrowUp')tilt=THREE.MathUtils.clamp(tilt-.08,-.2,1);if(e.key==='ArrowDown')tilt=THREE.MathUtils.clamp(tilt+.08,-.2,1);if(e.key==='+')zoom=Math.max(.7,zoom-.08);if(e.key==='-')zoom=Math.min(1.45,zoom+.08);if(e.key==='Home')$('#reset').onclick()}});function updateMotion(){$('#motion').textContent=paused?'▷':'Ⅱ';$('#motion').setAttribute('aria-pressed',String(paused));$('#motion').setAttribute('aria-label',paused?'Animation starten':'Animation pausieren');$('#motion').title=paused?'Animation starten':'Animation pausieren'}$('#motion').onclick=()=>{paused=!paused;updateMotion()};makeModel();updateMotion();resize();requestAnimationFrame(animate);\n\n\nmatchMedia('(prefers-reduced-motion: reduce)').addEventListener?.('change',e=>{paused=e.matches;updateMotion()});\n\n})();\n</script></body></html>",
    "position": "after",
    "height": 560
  }
